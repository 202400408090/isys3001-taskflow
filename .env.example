# ---------------------------------------------------------------------------
# .env.example
#
# TEMPLATE for a developer's private local `.env` file.
#
# Usage:
#   cp .env.example .env
#
# The real `.env` file is listed in .gitignore and MUST NEVER be committed,
# because it is where environment-specific values (and, in staging and
# production, secrets) live. Only this template is version controlled.
#
# Variable precedence implemented by src/config/index.js:
#   process.env  >  .env.<NODE_ENV>  >  .env  >  built-in default
#
# NOTE: `NODE_ENV` here selects the profile file that is layered on top of this
# one, so .env.development.example provides the development values.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
# Deployment environment. One of: development | test | staging | production
NODE_ENV=development

# TCP port the HTTP server binds to. 0 selects a random free port (used by tests).
# 8080 is the port the container image exposes, so production uses 8080.
PORT=8080

# Interface to bind. 0.0.0.0 is required inside a container.
HOST=0.0.0.0

# Value returned by GET / and shown in the client footer.
APP_NAME=TaskFlow

# --- Persistence ------------------------------------------------------------
# Filesystem path of the SQLite database file.
# Use the literal string `:memory:` for a throwaway in-memory database.
DATABASE_PATH=./data/taskflow.development.sqlite

# --- Security ---------------------------------------------------------------
# Shared secret required in the `X-API-Key` header for write operations.
# Leave EMPTY in development to disable write authentication.
# MUST be set to a strong random value in staging and production.
API_KEY=

# Comma-separated list of origins allowed to call the API from a browser.
# Use `*` only in development. Docker Compose overrides this value.
CORS_ORIGINS=*

# --- Observability ----------------------------------------------------------
# Minimum log level. One of: debug | info | warn | error
LOG_LEVEL=debug

# Emit one JSON object per line (true, for log aggregation) or
# human-readable lines (false, for local development).
LOG_FORMAT=pretty

# --- Rate limiting ----------------------------------------------------------
# Sliding window applied per client IP to /api/* routes.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# --- Request handling -------------------------------------------------------
# Maximum accepted JSON request body size, e.g. 16kb, 1mb.
BODY_LIMIT=64kb

# --- Deployment metadata ----------------------------------------------------
# Injected by the CI/CD pipeline at build time so that a running container can
# report exactly which revision it was built from. See docs/deployment.md.
APP_VERSION=1.0.0
GIT_COMMIT=local
BUILD_TIME=
