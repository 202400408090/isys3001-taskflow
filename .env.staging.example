# ---------------------------------------------------------------------------
# .env.staging.example
#
# STAGING environment profile.
#
# Staging must be a faithful rehearsal of production, so it deliberately
# differs from development in every way that could mask a defect:
#
#   *       JSON logs          - the same format the log pipeline parses
#   *       API key required   - write authentication is exercised
#   *       explicit CORS list - no wildcard to hide an origin mistake
#   *       info-level logging - no debug noise, as in production
#
# Replace every `<...>` placeholder with a real value. Secret values are
# injected by the CI/CD pipeline or the hosting platform's secret store and
# are NEVER written into a committed file.
# ---------------------------------------------------------------------------

NODE_ENV=staging

PORT=8080
HOST=0.0.0.0
APP_NAME=TaskFlow (staging)

DATABASE_PATH=./data/taskflow.staging.sqlite

# Must be at least 16 characters, otherwise start-up fails validation.
# The placeholder below is intentionally long enough that copying this file
# straight to `.env.staging` still boots. It MUST be replaced with a real
# secret injected from the CI/CD secret store before any shared deployment.
API_KEY=replace-with-staging-api-key-min-16-chars

# Explicit allow list - a wildcard is rejected at start-up here.
CORS_ORIGINS=https://staging.tasks.example.edu

LOG_LEVEL=info
LOG_FORMAT=json

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

BODY_LIMIT=64kb

# Rewritten by the pipeline at release time:
#   APP_VERSION <- the Git tag being released
#   GIT_COMMIT  <- the full SHA the image was built from
APP_VERSION=1.0.0
GIT_COMMIT=<injected-by-ci>
BUILD_TIME=<injected-by-ci>
