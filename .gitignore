# ---------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------
node_modules/
jspm_packages/
.pnp.*
.yarn/cache
.yarn/install-state.gz

# ---------------------------------------------------------------
# Environment files  (NEVER commit real secrets)
# ---------------------------------------------------------------
# Commit .env.example / .env.development.example instead.
.env
.env.*
!.env.example
!.env.development.example
!.env.staging.example
!.env.production.example

# ---------------------------------------------------------------
# Runtime data (SQLite database files are environment state)
# ---------------------------------------------------------------
data/
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db

# ---------------------------------------------------------------
# Logs
# ---------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------
# Build, coverage and cache output
# ---------------------------------------------------------------
dist/
build/
coverage/
.nyc_output/
.cache/
.tmp/
*.tsbuildinfo

# ---------------------------------------------------------------
# Generated evidence and preview artefacts
#
# Produced by scripts/collect-evidence.js and by document rendering. They
# are derivable from the history, so committing them would duplicate the
# repository's own content and would go stale on the very next commit.
# ---------------------------------------------------------------
evidence/
preview-*/

# ---------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# ---------------------------------------------------------------
# Local tooling state
# ---------------------------------------------------------------
.eslintcache
.node-version.local

# Temporary commit-message files, which are a normal way to write a
# multi-line message from a shell script and must never be committed.
.git-commit-msg.tmp
COMMIT_EDITMSG.local
