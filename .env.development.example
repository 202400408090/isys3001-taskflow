# ---------------------------------------------------------------------------
# .env.development.example
#
# DEVELOPMENT environment profile.
#
# This file is committed so that every developer's local setup is identical.
# Copy it to `.env.development` (which is git-ignored) and adjust as needed.
#
#   cp .env.development.example .env.development
#
# Development optimisations:
#   * verbose, human-readable logging
#   * write authentication disabled (empty API_KEY)
#   * permissive CORS so a separately served client can call the API
#   * a database file specific to this environment, so switching environment
#     never destroys data from another one
# ---------------------------------------------------------------------------

NODE_ENV=development

PORT=3000
HOST=0.0.0.0
APP_NAME=TaskFlow (dev)

DATABASE_PATH=./data/taskflow.development.sqlite

# Empty in development: write endpoints are open to speed up local iteration.
API_KEY=

# Allow the Vite dev server and any other local origin.
CORS_ORIGINS=*

LOG_LEVEL=debug
LOG_FORMAT=pretty

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

BODY_LIMIT=64kb

APP_VERSION=1.0.0
GIT_COMMIT=local
BUILD_TIME=
