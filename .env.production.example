# ---------------------------------------------------------------------------
# .env.production.example
#
# PRODUCTION environment profile.
#
# This file documents the configuration surface of the production deployment.
# No real secret ever appears here: every secret-valued variable is injected at
# deploy time from the platform secret store and is only referenced by name.
#
# Hard invariants enforced by src/config/index.js at start-up. Any violation
# aborts the process with a non-zero exit status BEFORE the port is opened, so
# the orchestrator never routes traffic to a misconfigured instance:
#
#   * NODE_ENV=production
#   * API_KEY present and >= 16 characters
#   * CORS_ORIGINS free of "*"
#   * LOG_FORMAT=json
# ---------------------------------------------------------------------------

NODE_ENV=production

PORT=8080
HOST=0.0.0.0
APP_NAME=TaskFlow

DATABASE_PATH=/var/lib/taskflow/taskflow.production.sqlite

# Injected from the platform secret store. Never committed.
#   Docker Compose : env_file / environment with ${PROD_API_KEY}
#   Kubernetes     : Secret -> envFrom.secretRef
API_KEY=replace-with-production-api-key-min-16-chars

CORS_ORIGINS=https://tasks.example.edu

# Production logs go to the aggregation pipeline as one JSON object per line.
LOG_LEVEL=warn
LOG_FORMAT=json

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

BODY_LIMIT=32kb

# Stamped by the release pipeline from the annotated Git tag and the commit SHA.
APP_VERSION=1.0.0
GIT_COMMIT=<injected-by-ci>
BUILD_TIME=<injected-by-ci>
