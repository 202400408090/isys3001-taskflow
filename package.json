{
  "name": "isys3001-todo-app",
  "version": "1.0.0",
  "description": "TaskFlow - a small task management web application built with zero external runtime dependencies for the ISYS3001 software development project.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/**/*.test.js\"",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "seed": "node scripts/seed.js",
    "smoke": "node scripts/smoke-test.js",
    "changelog": "node scripts/generate-changelog.js",
    "docker:build": "docker build -t isys3001/taskflow:$(node -p \"require('./package.json').version\") .",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app"
  },
  "keywords": [
    "isys3001",
    "task-management",
    "configuration-management"
  ],
  "author": "ISYS3001 Student",
  "license": "MIT"
}
