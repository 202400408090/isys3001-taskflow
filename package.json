{
  "name": "isys3001-todo-app",
  "version": "1.0.1",
  "description": "TaskFlow - a small task management web application built with zero external runtime dependencies for the ISYS3001 software development project.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/**/*.test.js\"",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "seed": "node scripts/seed.js",
    "smoke": "node scripts/smoke-test.js",
    "changelog": "node scripts/generate-changelog.js",
    "changelog:check": "node scripts/generate-changelog.js --check",
    "env:check": "node scripts/validate-env.js",
    "release": "node scripts/release.js release",
    "release:status": "node scripts/release.js status",
    "release:plan": "node scripts/release.js plan",
    "release:verify": "node scripts/release.js verify",
    "version:bump": "node scripts/release.js bump",
    "version:tag": "node scripts/release.js tag",
    "docker:build": "node scripts/build-image.js",
    "docker:up": "docker compose up --build --detach",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs --follow app"
  },
  "keywords": [
    "isys3001",
    "task-management",
    "configuration-management"
  ],
  "author": "ISYS3001 Student",
  "license": "MIT"
}
